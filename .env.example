# Image construite par build.sh
CUSTOM_IMAGE=ghcr.io/votre-organisation/geo-crm
CUSTOM_TAG=v1

# Nom du site Frappe = domaine public du CRM
SITE_NAME=crm.votre-domaine.fr

# Origine autorisee a appeler le CRM depuis la landing (adresse exacte du site)
ALLOW_CORS=https://www.votre-site.fr

# Mots de passe : generez-les, ne gardez pas ces valeurs
DB_ROOT_PASSWORD=changez-moi-db
ADMIN_PASSWORD=utilisez-un-mot-de-passe-long-et-unique
